limit_req_zone $binary_remote_addr zone=login:10m rate=6r/m;
limit_req_zone $binary_remote_addr zone=quiz:10m rate=30r/m;
server {
    listen 8080;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 308 https://${PUBLIC_HOST}$request_uri; }
}
server {
    listen 8443 ssl;
    server_name ${PUBLIC_HOST};
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/bhp-ip/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bhp-ip/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    client_max_body_size 1m;
    client_body_timeout 60s;
    proxy_read_timeout 300s;
    proxy_connect_timeout 10s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    location /api/auth/login {
        limit_req zone=login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
    }
    location /api/quiz {
        limit_req zone=quiz burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://app:3000;
    }
    location /api/admin/video {
        client_max_body_size 201m;
        proxy_pass http://app:3000;
    }
    location / { proxy_pass http://app:3000; }
}
# Health check stays inside the proxy container and is not published on the host.
server {
    listen 127.0.0.1:8081;
    location = /api/health { proxy_pass http://app:3000; }
    location / { return 404; }
}
