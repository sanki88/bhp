    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
